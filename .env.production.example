APP_NAME="Islamische Denkfabrik Toolbox"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE-ME.duckdns.org
APP_DOMAIN=CHANGE-ME.duckdns.org

DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database/database.sqlite

SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME@smtp-brevo.com
MAIL_PASSWORD=CHANGE-ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=CHANGE-ME@example.com
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stack
LOG_LEVEL=warning
